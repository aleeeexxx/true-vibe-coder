{
  "name": "ture-vibe-coder",
  "version": "1.1.0",
  "main": "dist-electron/main/index.js",
  "productName": "ture vibe coder",
  "description": "A relaxed remote workspace for coders on macOS",
  "author": "Alex Liu",
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-brand-assets.js && node scripts/build-apple-remote-helper.js && node scripts/prepare-build.js",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "semantic-release": "^25.0.2",
    "typescript": "^5.4.2",
    "vite": "^7.2.6",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.0.16"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
